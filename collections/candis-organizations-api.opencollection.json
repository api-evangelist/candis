{
  "opencollection": "1.0.0",
  "info": {
    "name": "Candis Core Data Organizations API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Organizations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Organization",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.candis.io/v1/organizations/info"
          },
          "docs": "Get Organization details in which the User is a member."
        }
      ]
    }
  ],
  "bundled": true
}